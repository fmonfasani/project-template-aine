# {{ project_name }} — environment template. Copy to .env (never commit .env).
#
# Without any of these set, the AI runtime falls back to a deterministic local
# provider so the project still installs, tests, and runs.

# --- LLM routing (OpenRouter) ----------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default model the runtime asks for when capability=auto. Examples:
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o-mini
#   meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=

# --- Optional: OpenAI direct (used if OpenRouter not available) ------------
OPENAI_API_KEY=
